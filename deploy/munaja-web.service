[Unit]
Description=Munaja web (Next.js)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=munaja
Group=munaja
WorkingDirectory=/opt/munaja/app
EnvironmentFile=/etc/munaja/munaja.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/opt/munaja/app/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/munaja/app/.next/cache

[Install]
WantedBy=multi-user.target
