# Nginx untuk Munajaa (alternatif Caddyfile.example). Server VPS owner memakai Nginx.
# Sertifikat: certbot --nginx -d apps.munajaapp.com
# TRUSTED_PROXY_HOPS=1 di env app: app membaca IP klien dari entri terakhir X-Forwarded-For yang ditambah Nginx ini.
server {
    listen 443 ssl http2;
    server_name apps.munajaapp.com;
    # ssl_certificate / ssl_certificate_key diisi certbot

    client_max_body_size 1m;   # webhook Scalev dibatasi 256 KB di app

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Timpa (bukan tambahkan) supaya entri palsu dari klien tidak ikut: app memakai 1 hop tepercaya.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
server {
    listen 80;
    server_name apps.munajaapp.com;
    return 301 https://$host$request_uri;
}
