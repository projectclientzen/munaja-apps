# Copy to /etc/munaja/munaja.env (root:munaja, mode 0640). NEVER commit the filled file.
# Secrets are created ON THE SERVER with: openssl rand -base64 32
# Never paste a real value into chat, a ticket, or the repo. Rotation: docs/DEPLOYMENT-NOTES.md.
# The runbook (docs/DEPLOYMENT-VPS.md, step 6) fills the CHANGE_ME_* lines with a script, so you do not copy them by hand.

NEXT_PUBLIC_DATA_MODE=live
NODE_ENV=production

# App connection: role munaja_app (not the owner). Password comes from /etc/munaja/db-app.pw.
DATABASE_URL=postgresql://munaja_app:CHANGE_ME_APP_PW@127.0.0.1:5432/munaja
# Owner connection for `pnpm db:migrate` only. Not read by the running services.
MIGRATE_DATABASE_URL=postgresql://munaja_owner:CHANGE_ME_OWNER_PW@127.0.0.1:5432/munaja

# Public address, no trailing slash. Needed for the one time password links.
APP_BASE_URL=https://CHANGE_ME_DOMAIN
APP_ORIGINS=
# One reverse proxy (Caddy) in front. The app refuses to start with 0 in production.
TRUSTED_PROXY_HOPS=1
ALLOW_INSECURE_COOKIES=false

# Three different random values, each from `openssl rand -base64 32`.
SESSION_PEPPER=CHANGE_ME_RANDOM
PHONE_HASH_KEY=CHANGE_ME_RANDOM
MFA_ENC_KEY=CHANGE_ME_RANDOM
PHONE_HASH_KEY_VERSION=1
MFA_ENC_KEY_VERSION=1

CRON_SECRET=CHANGE_ME_RANDOM
ACCOUNT_SELF_DELETE=false
NOTIF_ALLOW_DEMO_BANK=false

# Web Push. Generate on the server: pnpm exec web-push generate-vapid-keys
VAPID_SUBJECT=mailto:CHANGE_ME_SUPPORT_EMAIL
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Empty until permission to use EQuran.id is confirmed. Then: equran
PRAYER_PROVIDER=
SIHAT_API_TOKEN=

# Scalev. Fill these BEFORE saving the webhook in the Scalev dashboard (the endpoint answers 503 until they exist).
SCALEV_WEBHOOK_SIGNING_SECRET=
SCALEV_PAYLOAD_KEY=CHANGE_ME_RANDOM
SCALEV_API_BASE=https://api.scalev.com
SCALEV_API_KEY=
SCALEV_STORE_ID=
SCALEV_ALLOWED_VARIANT_IDS=
SCALEV_MIN_AMOUNT_IDR=
SCALEV_SWEEP_ENABLED=true
NEXT_PUBLIC_SCALEV_URL=
NEXT_PUBLIC_CS_WHATSAPP=
